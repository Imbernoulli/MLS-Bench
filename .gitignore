# Vendor (runtime artifacts)
vendor/external_packages/
vendor/images/
vendor/workspace/

# Held-out answer generators: dev-side only. The answer for each task travels
# INSIDE its harbor bundle (harbor/tasks/*/tests/); a standalone holdout/ at the
# repo root must never be published. Anchored so harbor/.../holdout/ is untouched.
/holdout/

# Config (runtime configs may contain secrets)
configs/*
!configs/react.yaml
!configs/openevolve.yaml
!configs/discover.yaml

# Results & logs (runtime)
results/
logs/
.saves/
.scheduler/

# Python
__pycache__/
*.pyc
*.egg-info/
.DS_Store

# Agent/development-local metadata
.claude/
.codex/
.agents/
context_packs/
paper_assets/

# build
build/

vendor/data/
vendor/data_cache/

# Cursor
.specstory/
.cursorindexingignore

# Misc junk
output/
*.out

# Harbor runtime artifacts (created by `harbor run`)
jobs/
harbor/jobs-daytona*/
harbor_adapter/scripts/__pycache__/
harbor_adapter/**/__pycache__/

# Leaderboard lockfiles from older runtime behavior
.mlsbench-slurm-query*.lock
tasks/**/leaderboard.csv.lock
tasks/agent-tool-reasoning/.openrouter_key
tasks/agent-tool-reasoning/.deepseek_key
tasks/agent-tool-reasoning/.dashscope_key
tasks/agent-tool-reasoning/.sopr_work/

# Daytona/Harbor run artifacts and scratch job directories
harbor/jobs-*/
harbor/daytona-*/
harbor/oracle-runs/
harbor/robo-humanoid-smoke-jobs/
harbor/mls-bench__*/
harbor/*.log
harbor/dataset.toml
daytona-lite-retry-*/
# verl source checkout fetched by vendor/packages.yaml (not vendored in git)
vendor/verl/

# Daytona smoke-validation scratch (reduced-scale task copies, run artifacts)
harbor/.smoke/
