{
  "base_image": "msai-cn-beijing.cr.volces.com/public/pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime",
  "install_cmds": [
    "pip install --no-cache-dir 'transformers>=4.41,<4.50' 'tokenizers>=0.20,<0.22' 'huggingface_hub<1.0' sentencepiece sacremoses 'sacrebleu>=2.3,<3' 'numpy<2'",
    "python -c \"import torch, transformers, sacrebleu; from transformers import AutoModelForSeq2SeqLM, AutoTokenizer; print('transformers', transformers.__version__, 'sacrebleu', sacrebleu.__version__, 'torch', torch.__version__)\""
  ],
  "env": {
    "MT_MODEL": "/data/machine-translation/models/opus-mt-de-en",
    "MT_DATA": "/data/machine-translation/data",
    "HF_HOME": "/tmp/huggingface",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "data_deps": [
    {
      "name": "machine_translation",
      "description": "Three revision-pinned Helsinki-NLP OPUS-MT MarianMT models (74,410,496 / 75,133,952 / 76,672,000 parameters) staged offline with exact checkpoint and tokenizer manifests, plus every row of the pinned 2,000-pair OPUS-100 test split for each source-to-English direction. Verification scores all 6,000 pairs and rejects any artifact or manifest mismatch.",
      "host_path": "{data_root}/machine-translation",
      "container_path": "/data/machine-translation",
      "ready_files": [
        "{data_root}/machine-translation/models/opus-mt-de-en/config.json",
        "{data_root}/machine-translation/models/opus-mt-de-en/generation_config.json",
        "{data_root}/machine-translation/models/opus-mt-de-en/pytorch_model.bin",
        "{data_root}/machine-translation/models/opus-mt-de-en/source.spm",
        "{data_root}/machine-translation/models/opus-mt-de-en/target.spm",
        "{data_root}/machine-translation/models/opus-mt-de-en/tokenizer_config.json",
        "{data_root}/machine-translation/models/opus-mt-de-en/vocab.json",
        "{data_root}/machine-translation/models/opus-mt-de-en/model_manifest.json",
        "{data_root}/machine-translation/models/opus-mt-fr-en/config.json",
        "{data_root}/machine-translation/models/opus-mt-fr-en/generation_config.json",
        "{data_root}/machine-translation/models/opus-mt-fr-en/model.safetensors",
        "{data_root}/machine-translation/models/opus-mt-fr-en/source.spm",
        "{data_root}/machine-translation/models/opus-mt-fr-en/target.spm",
        "{data_root}/machine-translation/models/opus-mt-fr-en/tokenizer_config.json",
        "{data_root}/machine-translation/models/opus-mt-fr-en/vocab.json",
        "{data_root}/machine-translation/models/opus-mt-fr-en/model_manifest.json",
        "{data_root}/machine-translation/models/opus-mt-ru-en/config.json",
        "{data_root}/machine-translation/models/opus-mt-ru-en/generation_config.json",
        "{data_root}/machine-translation/models/opus-mt-ru-en/pytorch_model.bin",
        "{data_root}/machine-translation/models/opus-mt-ru-en/source.spm",
        "{data_root}/machine-translation/models/opus-mt-ru-en/target.spm",
        "{data_root}/machine-translation/models/opus-mt-ru-en/tokenizer_config.json",
        "{data_root}/machine-translation/models/opus-mt-ru-en/vocab.json",
        "{data_root}/machine-translation/models/opus-mt-ru-en/model_manifest.json",
        "{data_root}/machine-translation/data/de_en_test.jsonl",
        "{data_root}/machine-translation/data/fr_en_test.jsonl",
        "{data_root}/machine-translation/data/ru_en_test.jsonl",
        "{data_root}/machine-translation/data/source_manifest.json"
      ],
      "prepare": "vendor/data_scripts/machine-translation/prepare_data.py"
    }
  ],
  "use_cuda": true,
  "writable_tmpfs": true,
  "workdir": "/workspace"
}
