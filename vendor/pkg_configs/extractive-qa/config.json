{
  "base_image": "msai-cn-beijing.cr.volces.com/public/pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime",
  "mangrove_base_image": "msai-cn-beijing.cr.volces.com/public/bohanlyu2022/mlsbench-harbor-extractive-qa@sha256:3bf1e39f4004791522670ee57d4aaa84ce040135bee896ff8dec16124f4a046e",
  "install_cmds": [
    "pip install --no-cache-dir --no-deps 'transformers==4.49.0' 'tokenizers==0.21.0' 'huggingface_hub==0.28.1' 'safetensors==0.5.2' 'regex==2024.11.6'",
    "python -c \"import numpy, torch, transformers; assert numpy.__version__ == '2.1.2'; print('numpy', numpy.__version__, 'torch', torch.__version__, 'transformers', transformers.__version__)\""
  ],
  "env": {
    "QA_MODEL": "/data/extractive-qa/models/roberta-base-squad2",
    "QA_DATA": "/data/extractive-qa/data",
    "HF_HOME": "/data/extractive-qa/hf_home",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "data_deps": [
    {
      "name": "extractive_qa_full_v2",
      "description": "Pinned deepset/roberta-base-squad2 checkpoint, fine-tuned upstream on the complete SQuAD 2.0 training set, plus deterministic full official MRQA and SQuAD v2 validation fixtures. MRQA contributes all 10,507 SQuAD, 4,212 NewsQA, 5,901 HotpotQA, and 12,836 NaturalQuestionsShort validation rows. All 11,873 SQuAD v2 validation rows are partitioned exhaustively by original index modulo three. Every model and fixture file is SHA-256 verified before scoring.",
      "host_path": "{data_root}/extractive-qa",
      "container_path": "/data/extractive-qa",
      "ready_files": [
        "{data_root}/extractive-qa/models/roberta-base-squad2/config.json",
        "{data_root}/extractive-qa/models/roberta-base-squad2/model.safetensors",
        "{data_root}/extractive-qa/models/roberta-base-squad2/merges.txt",
        "{data_root}/extractive-qa/models/roberta-base-squad2/vocab.json",
        "{data_root}/extractive-qa/models/roberta-base-squad2/tokenizer_config.json",
        "{data_root}/extractive-qa/models/roberta-base-squad2/special_tokens_map.json",
        "{data_root}/extractive-qa/data/mrqa_squad_validation.jsonl",
        "{data_root}/extractive-qa/data/mrqa_newsqa_validation.jsonl",
        "{data_root}/extractive-qa/data/mrqa_hotpotqa_validation.jsonl",
        "{data_root}/extractive-qa/data/mrqa_naturalquestions_validation.jsonl",
        "{data_root}/extractive-qa/data/squad2_validation_part0.jsonl",
        "{data_root}/extractive-qa/data/squad2_validation_part1.jsonl",
        "{data_root}/extractive-qa/data/squad2_validation_part2.jsonl"
      ],
      "prepare": "vendor/data_scripts/extractive-qa/prepare_data.py"
    }
  ],
  "use_cuda": true,
  "writable_tmpfs": true,
  "workdir": "/workspace"
}
