{
  "base_image": "msai-cn-beijing.cr.volces.com/public/pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime",
  "install_cmds": [
    "pip install --no-cache-dir 'numpy==1.26.4' 'transformers==4.48.3' 'tokenizers==0.21.0' 'accelerate==1.2.1' 'datasets==2.21.0' 'huggingface_hub==0.28.1' 'safetensors==0.5.2' 'sentencepiece==0.2.0' 'protobuf==5.29.3'",
    "python -c \"import datasets, torch, transformers; assert transformers.__version__ == '4.48.3'; assert datasets.__version__ == '2.21.0'; print('codegen-lab', torch.__version__, transformers.__version__, datasets.__version__)\""
  ],
  "env": {
    "CG_MODEL": "/data/code-generation/models/Qwen2.5-Coder-1.5B-Instruct",
    "CG_DATA": "/data/code-generation/data",
    "HF_HOME": "/data/code-generation/hf_home",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false",
    "PYTHONPATH": "/workspace/code-generation-lab:${PYTHONPATH}"
  },
  "agent_pruned_files": [
    "anchor_baselines",
    "baselines"
  ],
  "data_deps": [
    {
      "name": "code-generation",
      "host_path": "{data_root}/code-generation",
      "container_path": "/data/code-generation",
      "prepare": "vendor/data_scripts/code-generation-lab/prepare_data.py",
      "verify_existing": true,
      "ready_files": [
        "{data_root}/code-generation/data/problems.json",
        "{data_root}/code-generation/data/manifest.json",
        "{data_root}/code-generation/models/Qwen2.5-Coder-1.5B-Instruct/model_manifest.json",
        "{data_root}/code-generation/models/Qwen2.5-Coder-1.5B-Instruct/config.json",
        "{data_root}/code-generation/models/Qwen2.5-Coder-1.5B-Instruct/generation_config.json",
        "{data_root}/code-generation/models/Qwen2.5-Coder-1.5B-Instruct/merges.txt",
        "{data_root}/code-generation/models/Qwen2.5-Coder-1.5B-Instruct/model.safetensors",
        "{data_root}/code-generation/models/Qwen2.5-Coder-1.5B-Instruct/tokenizer.json",
        "{data_root}/code-generation/models/Qwen2.5-Coder-1.5B-Instruct/tokenizer_config.json",
        "{data_root}/code-generation/models/Qwen2.5-Coder-1.5B-Instruct/vocab.json"
      ],
      "description": "Qwen2.5-Coder-1.5B-Instruct revision 357b899b4714bf46d935fb9911e8139b5b9efc29 and MBPP revision 4bb6404fdc6cacfda99d4ac4205087b89d32030c define the 257-problem protocol. Verification intentionally fails closed until a worker backfills the canonical problem digest and per-file model size/SHA256 pins. One provided assertion may guide inference-time policies; all remaining assertions determine execution-based pass@1. Runtime verification is offline and deterministic at seed 42."
    }
  ],
  "use_cuda": true,
  "writable_tmpfs": true,
  "workdir": "/workspace"
}
