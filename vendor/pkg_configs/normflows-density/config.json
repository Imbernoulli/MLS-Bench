{
  "base_image": "msai-cn-beijing.cr.volces.com/public/pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime",
  "mangrove_base_image": "msai-cn-beijing.cr.volces.com/public/bohanlyu2022/mlsbench-harbor-normflows-density@sha256:3b81a711a7a6a00234a5717f7f5199ae124faee0d7cf24b0527e186ebbf40837",
