#!/bin/bash
# vfi-synthesis [small = small inter-frame motion]: train the fixed compact VFI net with the
# agent-designed synthesis strategy (blend / flow_warp / learned), then score interpolation
# PSNR of the synthesized middle frame vs the true middle frame on the held-out val split.
set -e
# NOTE: do NOT hardcode CUDA_VISIBLE_DEVICES here. The verifier
# (score_task.py) runs this task's test_cmds concurrently within the same
# group and assigns each one a DISTINCT physical GPU via CUDA_VISIBLE_DEVICES
# in the subprocess env (see _allocate_group_gpu_assignments/_run_eval_wave).
# Hardcoding =0 here overrides that assignment and forces concurrent runs
# onto the same physical GPU, causing OOM collisions. Inherit whatever the
# harness set.
cd /workspace/video-frame-interp
python harness.py \
    --data-root ${VFI_DATA_ROOT:-/data/video-frame-interp} \
    --surface synthesis \
    --motion small \
    --label small \
    --solution solution/synthesis.py \
    --iters ${VFI_ITERS:-800} \
    --seed ${SEED:-42}
