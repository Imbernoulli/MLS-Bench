{
  "allow_create": false,
  "rigorous_codebase": true,
  "verifier_only_package_files": [
    "torchreid-reid/common.py",
    "torchreid-reid/harness_finetune.py"
  ],
  "agent_data_prune": [
    "/data/torchreid/market1501_full/query",
    "/data/torchreid/market1501_full/gallery",
    "/data/torchreid/_targeted",
    "/data/torchreid/_cache"
  ],
  "verifier_data_deps": [
    {
      "host_path": "{data_root}/torchreid/market1501_full/query",
      "dest": "data/market1501_full/query"
    },
    {
      "host_path": "{data_root}/torchreid/market1501_full/gallery",
      "dest": "data/market1501_full/gallery"
    }
  ],
  "seeds": [
    42
  ],
  "test_cmds": [
    {
      "cmd": "scripts/train.sh",
      "label": "market",
      "group": 1,
      "compute": 1.0,
      "time": "6:00:00",
      "mem": 64,
      "package": "torchreid-reid"
    }
  ],
  "baselines": {
    "frozen": {
      "edit_ops": "edits/frozen.edit.py"
    },
    "partial": {
      "edit_ops": "edits/partial.edit.py"
    },
    "full": {
      "edit_ops": "edits/full.edit.py"
    }
  },
  "files": [
    {
      "filename": "torchreid-reid/solution/finetune.py",
      "read": [
        {
          "start": -1,
          "end": -1
        }
      ],
      "edit": [
        {
          "start": 12,
          "end": 15
        }
      ]
    }
  ]
}
