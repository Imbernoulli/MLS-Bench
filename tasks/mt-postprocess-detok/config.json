{
  "allow_create": false,
  "rigorous_codebase": true,
  "seeds": [
    42
  ],
  "test_cmds": [
    {
      "cmd": "scripts/opus_de_en.sh",
      "label": "de_en",
      "group": 1,
      "compute": 1,
      "time": "1:30:00",
      "mem": 24,
      "package": "machine-translation"
    },
    {
      "cmd": "scripts/opus_fr_en.sh",
      "label": "fr_en",
      "group": 2,
      "compute": 1,
      "time": "1:30:00",
      "mem": 24,
      "package": "machine-translation"
    },
    {
      "cmd": "scripts/opus_ru_en.sh",
      "label": "ru_en",
      "group": 3,
      "compute": 1,
      "time": "1:30:00",
      "mem": 24,
      "package": "machine-translation"
    }
  ],
  "baselines": {
    "lower": {
      "edit_ops": "edits/lower.edit.py"
    },
    "strip": {
      "edit_ops": "edits/strip.edit.py"
    },
    "norm": {
      "edit_ops": "edits/norm.edit.py"
    }
  },
  "files": [
    {
      "filename": "machine-translation/solution/postproc.py",
      "read": [
        {
          "start": -1,
          "end": -1
        }
      ],
      "edit": [
        {
          "start": 11,
          "end": 11
        }
      ]
    }
  ],
  "verifier_only_package_files": [
    "machine-translation/common.py",
    "machine-translation/harness_postproc.py"
  ],
  "agent_pruned_package_files": [
