    "machine-translation/baselines/earlystop_true.py",
    "machine-translation/baselines/length_short.py",
    "machine-translation/baselines/length_tuned.py",
    "machine-translation/baselines/maxlen_10.py",
    "machine-translation/baselines/maxlen_128.py",
    "machine-translation/baselines/maxlen_32.py",
    "machine-translation/baselines/norep3.py",
    "machine-translation/baselines/norep_agg1.py",
    "machine-translation/baselines/norep_off.py",
