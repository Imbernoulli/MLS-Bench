    "machine-translation/baselines/reppen_high.py",
    "machine-translation/baselines/reppen_off.py",
    "machine-translation/baselines/reppen_tuned.py",
    "machine-translation/baselines/sampling_beam.py",
    "machine-translation/baselines/sampling_greedy.py",
    "machine-translation/baselines/sampling_t1.py",
    "machine-translation/baselines/sampling_topp.py",
    "machine-translation/baselines/strategy_beam.py",
    "machine-translation/baselines/strategy_copy_source.py",
